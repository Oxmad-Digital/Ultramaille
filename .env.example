# MongoDB Atlas — chaîne de connexion du cluster (base "ultramaille")
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/ultramaille

# NextAuth — clé secrète pour signer les sessions (générer avec: openssl rand -base64 32)
AUTH_SECRET=

# Compte admin unique pour /admin
ADMIN_EMAIL=admin@ultramaille.mg
# Hash bcrypt du mot de passe (générer avec le script scripts/hash-password.mjs)
# Important : échapper les "$" (\$) sinon Next.js les interprète comme des
# références de variables ($2b -> variable "2b") et corrompt le hash.
ADMIN_PASSWORD_HASH=

# Cloudinary — preset d'upload non signé (dashboard Cloudinary > Settings > Upload > Add upload preset, "Unsigned")
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
